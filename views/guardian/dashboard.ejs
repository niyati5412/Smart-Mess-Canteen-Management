<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MessMate | Guardian Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
:root {
  --bg:#0a0d0f;--surface:#111518;--surface2:#181d21;--surface3:#1e2428;
  --border:rgba(255,255,255,0.07);--text:#e8edf2;--muted:#7a8a96;
  --accent:#f4c542;--accent2:#00b8ff;--accent3:#00e5a0;--danger:#ff4757;--sidebar:220px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);display:flex;overflow:hidden}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--surface3);border-radius:2px}
.sidebar{width:var(--sidebar);flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;height:100vh;position:sticky;top:0;overflow-y:auto}
.sidebar-logo{padding:24px 20px 20px;border-bottom:1px solid var(--border)}
.logo-text{font-weight:800;font-size:1.25rem;color:var(--accent);text-decoration:none;display:block}
.logo-text span{color:var(--text)}
.logo-sub{font-size:0.65rem;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-top:2px}
.sidebar-user{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.user-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2a1f04,#f4c542);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.78rem;color:rgba(10,13,15,0.9);flex-shrink:0;overflow:hidden}
.user-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.user-name{font-size:0.82rem;font-weight:500}.user-id{font-size:0.68rem;color:var(--muted)}
.sidebar-nav{flex:1;padding:12px;display:flex;flex-direction:column;gap:2px}
.nav-label{font-size:0.62rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);padding:10px 8px 6px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;text-decoration:none;color:var(--muted);font-size:0.85rem;font-weight:500;transition:all 0.18s;position:relative;cursor:pointer}
.nav-item:hover{background:var(--surface2);color:var(--text)}
.nav-item.active{background:rgba(244,197,66,0.08);color:var(--accent)}
.nav-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:2px;border-radius:0 2px 2px 0;background:var(--accent)}
.nav-icon{font-size:1rem;width:20px;text-align:center;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--accent);color:#0a0d0f;font-size:0.6rem;font-weight:800;padding:1px 6px;border-radius:100px}
.sidebar-bottom{padding:12px;border-top:1px solid var(--border)}
.logout-btn{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;color:var(--muted);font-size:0.82rem;cursor:pointer;transition:all 0.18s;text-decoration:none}
.logout-btn:hover{color:var(--danger);background:rgba(255,71,87,0.06)}
.main{flex:1;overflow-y:auto;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:50;background:rgba(10,13,15,0.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:14px 32px;display:flex;align-items:center;justify-content:space-between}
.topbar h1{font-size:1.1rem;font-weight:800;letter-spacing:-0.3px}
.topbar p{font-size:0.78rem;color:var(--muted);margin-top:1px}
.topbar-right{display:flex;align-items:center;gap:10px}
.mobile-menu-btn{display:none;width:34px;height:34px;border-radius:8px;background:var(--surface2);border:1px solid var(--border);align-items:center;justify-content:center;cursor:pointer;font-size:1rem}
.content{padding:28px 32px;flex:1}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:14px}
.panel-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.panel-head h3{font-size:0.85rem;font-weight:700}
.panel-action{font-size:0.72rem;color:var(--accent);cursor:pointer;text-decoration:none;transition:opacity 0.2s}
.panel-action:hover{opacity:0.7}
.panel-body{padding:14px 16px}
.ward-switcher{display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap}
.ward-card{display:flex;align-items:center;gap:10px;padding:10px 16px;border-radius:14px;border:1px solid var(--border);background:var(--surface);cursor:pointer;transition:all 0.2s;text-decoration:none}
.ward-card:hover{border-color:rgba(244,197,66,0.3)}
.ward-card.active{border-color:rgba(244,197,66,0.4);background:rgba(244,197,66,0.06)}
.ward-av{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.75rem;flex-shrink:0;background:linear-gradient(135deg,#0f2520,#00e5a0);color:rgba(255,255,255,0.9)}
.ward-name{font-weight:700;font-size:0.85rem}.ward-id{font-size:0.68rem;color:var(--muted)}
.ward-status{display:flex;align-items:center;gap:5px;font-size:0.65rem;font-weight:700;margin-top:2px}
.status-dot{width:5px;height:5px;border-radius:50%}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px 18px}
.stat-label{font-size:0.72rem;color:var(--muted);margin-bottom:8px;font-weight:500}
.stat-val{font-size:1.9rem;font-weight:800;letter-spacing:-1px;line-height:1;margin-bottom:6px}
.stat-sub{font-size:0.7rem;color:var(--muted)}
.today-panel{background:linear-gradient(135deg,rgba(244,197,66,0.06),rgba(0,184,255,0.04));border:1px solid rgba(244,197,66,0.18);border-radius:16px;padding:20px 24px;margin-bottom:20px}
.tp-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.tp-title{font-weight:800;font-size:1rem}.tp-date{font-size:0.75rem;color:var(--muted)}
.meals-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.meal-box{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;transition:border-color 0.3s}
.meal-box.eating{border-color:rgba(0,229,160,0.3)}.meal-box.skipping{border-color:rgba(255,71,87,0.3)}
.mb-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.mb-emoji{font-size:1.2rem}.mb-name{font-weight:700;font-size:0.78rem;margin-bottom:6px}
.mb-state{font-size:0.72rem;font-weight:700;display:flex;align-items:center;gap:5px}
.mb-state.eating{color:var(--accent3)}.mb-state.skipping{color:var(--danger)}.mb-state.pending{color:var(--muted)}
.mb-time{font-size:0.62rem;color:var(--muted)}
.lower-grid{display:grid;grid-template-columns:1fr 360px;gap:16px}
.right-col{display:flex;flex-direction:column;gap:12px}
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.cal-month{font-size:0.9rem;font-weight:700}
.cal-arr{width:28px;height:28px;border-radius:7px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:0.8rem;color:var(--muted);transition:all 0.2s}
.cal-arr:hover{border-color:var(--accent);color:var(--accent)}
.cal-days-head{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:4px}
.cal-day-name{text-align:center;font-size:0.6rem;font-weight:600;color:var(--muted);padding:4px 0;letter-spacing:0.5px}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-day{aspect-ratio:1;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:0.72rem;color:var(--muted);cursor:default}
.cal-day.other{opacity:0.2}.cal-day.ate{background:rgba(0,229,160,0.12);color:var(--accent3);font-weight:600}
.cal-day.skipped{background:rgba(255,71,87,0.1);color:var(--danger);font-weight:600}
.cal-day.partial{background:rgba(244,197,66,0.1);color:var(--accent);font-weight:600}
.cal-day.today{border:1.5px solid var(--accent2);color:var(--text);font-weight:700}.cal-day.future{opacity:0.3}
.cal-legend{display:flex;gap:12px;margin-top:14px;flex-wrap:wrap}
.legend-item{display:flex;align-items:center;gap:4px;font-size:0.67rem;color:var(--muted)}
.legend-dot{width:7px;height:7px;border-radius:50%}
.budget-wrap{display:flex;align-items:center;gap:18px;margin-bottom:16px}
.donut-svg{width:80px;height:80px;flex-shrink:0}
.bstats{display:flex;flex-direction:column;gap:8px;flex:1}
.bs-label{font-size:0.68rem;color:var(--muted);margin-bottom:2px}.bs-val{font-weight:700;font-size:1rem}
.bdown{display:flex;flex-direction:column;gap:7px}
.bd-row{display:flex;justify-content:space-between}
.bd-label{font-size:0.74rem;color:var(--muted);display:flex;align-items:center;gap:5px}
.bd-dot{width:6px;height:6px;border-radius:50%}.bd-val{font-size:0.74rem;font-weight:600}
.alert-list{display:flex;flex-direction:column;gap:0}
.alert-item{display:flex;align-items:flex-start;gap:10px;padding:12px 0;border-bottom:1px solid var(--border)}
.alert-item:last-child{border-bottom:none}
.alert-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:0.85rem;flex-shrink:0;margin-top:1px}
.alert-icon.warn{background:rgba(244,197,66,0.1)}.alert-icon.info{background:rgba(0,184,255,0.1)}
.alert-icon.good{background:rgba(0,229,160,0.1)}.alert-icon.bad{background:rgba(255,71,87,0.1)}
.alert-text{font-size:0.78rem;font-weight:500;margin-bottom:2px}.alert-sub{font-size:0.68rem;color:var(--muted)}
.notif-prefs{display:flex;flex-direction:column;gap:10px}
.notif-row{display:flex;align-items:center;justify-content:space-between}
.notif-label{font-size:0.78rem}.notif-sub{font-size:0.68rem;color:var(--muted)}
.toggle{width:36px;height:20px;border-radius:100px;cursor:pointer;position:relative;transition:background 0.2s;flex-shrink:0;border:none}
.toggle.on{background:var(--accent)}.toggle.off{background:var(--surface3)}
.toggle::after{content:'';position:absolute;width:14px;height:14px;border-radius:50%;background:#fff;top:3px;transition:left 0.2s}
.toggle.on::after{left:19px}.toggle.off::after{left:3px}
.report-card{background:linear-gradient(135deg,rgba(244,197,66,0.07),rgba(0,184,255,0.04));border:1px solid rgba(244,197,66,0.2);border-radius:16px;padding:20px;margin-bottom:16px;display:flex;align-items:center;gap:20px}
.rc-icon{font-size:2.5rem;flex-shrink:0}
.rc-title{font-weight:800;font-size:0.95rem;margin-bottom:4px}
.rc-sub{font-size:0.76rem;color:var(--muted);margin-bottom:14px;line-height:1.5}
.btn-dl{padding:9px 20px;border-radius:9px;background:var(--accent);color:#0a0d0f;font-size:0.8rem;font-weight:800;border:none;cursor:pointer;transition:all 0.2s;display:inline-flex;align-items:center;gap:6px}
.btn-dl:hover{background:#ffd84d}
.spinner{width:24px;height:24px;border:2px solid var(--surface3);border-top-color:var(--accent);border-radius:50%;animation:spin 0.7s linear infinite;margin:20px auto}
@keyframes spin{to{transform:rotate(360deg)}}
.state-box{padding:24px;text-align:center;color:var(--muted);font-size:0.8rem}
.toast-wrap{position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:10px;font-size:0.82rem;min-width:240px;box-shadow:0 8px 32px rgba(0,0,0,0.5);transform:translateY(8px);opacity:0;transition:all 0.35s cubic-bezier(0.22,1,0.36,1);pointer-events:all}
.toast.show{transform:translateY(0);opacity:1}.toast-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
#overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:199}
@media(max-width:1100px){.stats-grid{grid-template-columns:1fr 1fr}}
@media(max-width:900px){
  .sidebar{position:fixed;left:-100%;top:0;z-index:200;transition:left 0.3s;width:240px}
  .sidebar.open{left:0}.mobile-menu-btn{display:flex}
  .stats-grid{grid-template-columns:1fr 1fr}.lower-grid{grid-template-columns:1fr}
  .right-col{flex-direction:row;flex-wrap:wrap}.right-col .panel{flex:1 1 280px}
  .content{padding:20px 16px}.topbar{padding:14px 16px}.meals-row{grid-template-columns:1fr 1fr}
}
@media(max-width:560px){.meals-row{grid-template-columns:1fr 1fr}.stats-grid{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <a href="/" class="logo-text">Mess<span>Mate</span></a>
    <div class="logo-sub">Guardian Portal</div>
  </div>
  <div class="sidebar-user">
    <div class="user-avatar" id="userAvatar">?</div>
    <div>
      <div class="user-name" id="userName">Loading…</div>
      <div class="user-id">Parent / Guardian</div>
      <div style="font-size:0.6rem;color:var(--muted);margin-top:1px;word-break:break-all" id="userEmail"></div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-label">Overview</div>
    <!-- ✅ FIXED: All .html links removed -->
    <a class="nav-item active" href="/guardian/dashboard"><span class="nav-icon">🏠</span> Dashboard</a>
    <a class="nav-item" href="#"><span class="nav-icon">📅</span> Attendance</a>
    <a class="nav-item" href="/guardian/budget"><span class="nav-icon">💰</span> Budget</a>
    <a class="nav-item" href="#"><span class="nav-icon">📊</span> Reports <span class="nav-badge">1</span></a>
    <div class="nav-label">Alerts</div>
    <a class="nav-item" href="#"><span class="nav-icon">🔔</span> Notifications <span class="nav-badge" id="alertBadge">0</span></a>
    <a class="nav-item" href="#"><span class="nav-icon">⚙️</span> Preferences</a>
  </nav>
  <div class="sidebar-bottom">
    <!-- ✅ FIXED: logout → /login -->
    <a class="logout-btn" href="/login" onclick="sessionStorage.removeItem('mm_session')">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign Out
    </a>
  </div>
</aside>

<div class="main">
  <div class="topbar">
    <div>
      <h1>Guardian Dashboard</h1>
      <p id="wardLabel">Monitoring ward's mess activity</p>
    </div>
    <div class="topbar-right">
      <span style="font-size:0.72rem;color:var(--muted);background:var(--surface2);border:1px solid var(--border);padding:6px 12px;border-radius:8px;" id="todayDate">—</span>
      <div class="mobile-menu-btn" onclick="toggleSidebar()">☰</div>
    </div>
  </div>

  <div class="content">
    <div class="ward-switcher">
      <div class="ward-card active" id="wardCard">
        <div class="ward-av" id="wardAvatar">?</div>
        <div>
          <div class="ward-name" id="wardName">Loading…</div>
          <div class="ward-id" id="wardStudentIdDisplay">—</div>
          <div class="ward-status">
            <div class="status-dot" id="wardStatusDot" style="background:var(--muted)"></div>
            <span id="wardStatusText" style="color:var(--muted)">Fetching data…</span>
          </div>
        </div>
      </div>
      <div style="display:flex;align-items:center;padding:10px 16px;border:1px dashed rgba(255,255,255,0.1);border-radius:14px;cursor:pointer;color:var(--muted);font-size:0.82rem;gap:8px;transition:all 0.2s"
           onmouseenter="this.style.borderColor='rgba(244,197,66,0.3)'"
           onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'"
           onclick="showToast('Ward management coming soon!','var(--accent)')">
        <span style="font-size:1.2rem">+</span> Add Ward
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-label">Meals This Month</div><div class="stat-val" style="color:var(--accent3)" id="statMeals">—</div><div class="stat-sub" id="statMealsMax">calculating…</div></div>
      <div class="stat-card"><div class="stat-label">Budget Efficiency</div><div class="stat-val" style="color:var(--accent)" id="statEff">—</div><div class="stat-sub" id="statEffSub">calculating…</div></div>
      <div class="stat-card"><div class="stat-label">Meals Skipped</div><div class="stat-val" style="color:var(--danger)" id="statSkipped">—</div><div class="stat-sub" id="statWasted">calculating…</div></div>
      <div class="stat-card"><div class="stat-label">Current Streak</div><div class="stat-val" style="color:var(--accent2)" id="statStreak">—</div><div class="stat-sub">days eating all meals 🔥</div></div>
    </div>

    <div class="today-panel">
      <div class="tp-top">
        <div class="tp-title">Today's Meal Status</div>
        <div class="tp-date" id="todayPanelDate">—</div>
      </div>
      <div class="meals-row">
        <div class="meal-box" id="box_breakfast"><div class="mb-top"><span class="mb-emoji">🌅</span><span style="font-size:0.6rem;color:var(--muted)">7:30–9:00</span></div><div class="mb-name">Breakfast</div><div class="mb-state pending" id="meal_breakfast_state">⏳ Not marked</div><div class="mb-time" id="meal_breakfast_time">Awaiting student input</div></div>
        <div class="meal-box" id="box_lunch"><div class="mb-top"><span class="mb-emoji">☀️</span><span style="font-size:0.6rem;color:var(--muted)">12:30–2:00</span></div><div class="mb-name">Lunch</div><div class="mb-state pending" id="meal_lunch_state">⏳ Not marked</div><div class="mb-time" id="meal_lunch_time">Awaiting student input</div></div>
        <div class="meal-box" id="box_dinner"><div class="mb-top"><span class="mb-emoji">🌙</span><span style="font-size:0.6rem;color:var(--muted)">7:30–9:00</span></div><div class="mb-name">Dinner</div><div class="mb-state pending" id="meal_dinner_state">⏳ Not marked</div><div class="mb-time" id="meal_dinner_time">Awaiting student input</div></div>
        <div class="meal-box" id="box_snacks"><div class="mb-top"><span class="mb-emoji">☕</span><span style="font-size:0.6rem;color:var(--muted)">4:30–5:30</span></div><div class="mb-name">Snacks</div><div class="mb-state pending" id="meal_snacks_state">⏳ Not marked</div><div class="mb-time" id="meal_snacks_time">Awaiting student input</div></div>
      </div>
    </div>

    <div class="lower-grid">
      <div class="panel">
        <div class="panel-head"><h3 id="attendancePanelHead">Attendance</h3><a href="#" class="panel-action" onclick="exportAttendanceCSV(); return false">Export CSV →</a></div>
        <div class="panel-body">
          <div class="cal-nav">
            <div class="cal-arr" onclick="calPrev()">‹</div>
            <span class="cal-month" id="calMonthHead">Loading…</span>
            <div class="cal-arr" onclick="calNext()">›</div>
          </div>
          <div class="cal-days-head">
            <div class="cal-day-name">SUN</div><div class="cal-day-name">MON</div>
            <div class="cal-day-name">TUE</div><div class="cal-day-name">WED</div>
            <div class="cal-day-name">THU</div><div class="cal-day-name">FRI</div>
            <div class="cal-day-name">SAT</div>
          </div>
          <div class="cal-grid" id="calGrid"></div>
          <div class="cal-legend">
            <div class="legend-item"><div class="legend-dot" style="background:var(--accent3)"></div>All meals</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--accent)"></div>Partial</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--danger)"></div>Skipped</div>
          </div>
        </div>
      </div>

      <div class="right-col">
        <div class="panel">
          <div class="panel-head"><h3>Budget Overview</h3><a href="/guardian/budget" class="panel-action">Details →</a></div>
          <div class="panel-body">
            <div class="budget-wrap">
              <svg class="donut-svg" viewBox="0 0 36 36">
                <circle cx="18" cy="18" r="14" fill="none" stroke="#1e2428" stroke-width="4"/>
                <circle id="donutArc" cx="18" cy="18" r="14" fill="none" stroke="#f4c542" stroke-width="4" stroke-dasharray="0 100" stroke-dashoffset="25" stroke-linecap="round" style="transition:stroke-dasharray 1s ease"/>
                <text x="18" y="19.5" text-anchor="middle" font-size="6.5" fill="#e8edf2" font-weight="800" id="donutPct">—</text>
              </svg>
              <div class="bstats">
                <div><div class="bs-label">Fee Paid</div><div class="bs-val" id="budgetTotal">₹6,000</div></div>
                <div><div class="bs-label">Value Consumed</div><div class="bs-val" style="color:var(--accent2)" id="budgetConsumed">₹—</div></div>
              </div>
            </div>
            <div class="bdown">
              <div class="bd-row"><span class="bd-label"><div class="bd-dot" style="background:var(--accent2)"></div>Consumed</span><span class="bd-val" style="color:var(--accent2)" id="budgetConsumed2">₹—</span></div>
              <div class="bd-row"><span class="bd-label"><div class="bd-dot" style="background:var(--danger)"></div>Skipped cost</span><span class="bd-val" style="color:var(--danger)" id="budgetSkipped">₹—</span></div>
              <div class="bd-row" style="margin-top:4px;padding-top:8px;border-top:1px solid var(--border)"><span class="bd-label" style="font-size:0.68rem">Per meal value</span><span class="bd-val" id="perMealVal" style="color:var(--muted);font-size:0.72rem">₹67</span></div>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-head"><h3>Recent Alerts</h3><a href="#" class="panel-action">All →</a></div>
          <div class="panel-body" style="padding-top:6px;padding-bottom:6px;">
            <div class="alert-list" id="alertList"><div class="state-box"><div class="spinner"></div>Loading alerts…</div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="report-card">
      <div class="rc-icon">📋</div>
      <div>
        <div class="rc-title" id="reportTitle">Monthly Report</div>
        <div class="rc-sub" id="reportSub">Loading report details…</div>
        <button class="btn-dl" onclick="downloadReport()">⬇ Download CSV</button>
      </div>
    </div>

    <div class="panel" style="margin-bottom:20px">
      <div class="panel-head"><h3>Notification Preferences</h3></div>
      <div class="panel-body">
        <div class="notif-prefs">
          <div class="notif-row"><div><div class="notif-label">Missed meal alert</div><div class="notif-sub">Notify when a meal is skipped</div></div><button class="toggle on" onclick="this.classList.toggle('on');this.classList.toggle('off')"></button></div>
          <div class="notif-row"><div><div class="notif-label">Daily summary (7 PM)</div><div class="notif-sub">End-of-day meal recap via email</div></div><button class="toggle on" onclick="this.classList.toggle('on');this.classList.toggle('off')"></button></div>
          <div class="notif-row"><div><div class="notif-label">Weekly digest</div><div class="notif-sub">Every Monday morning</div></div><button class="toggle off" onclick="this.classList.toggle('on');this.classList.toggle('off')"></button></div>
          <div class="notif-row"><div><div class="notif-label">Monthly report email</div><div class="notif-sub">Auto-sent on 1st of each month</div></div><button class="toggle on" onclick="this.classList.toggle('on');this.classList.toggle('off')"></button></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>
<div id="overlay" onclick="toggleSidebar()"></div>

<script>
const MEAL_COST    = 67;
const SEMESTER_FEE = 6000;

// ✅ FIXED: session check with correct redirects
function requireGuardianSession() {
  try {
    const s = JSON.parse(sessionStorage.getItem('mm_session'));
    if (!s) { window.location.href = '/login'; return null; }
    if (s.role !== 'guardian') {
      const map = { student: '/student/dashboard', admin: '/admin/dashboard' };
      window.location.href = map[s.role] || '/login';
      return null;
    }
    return s;
  } catch(e) { window.location.href = '/login'; return null; }
}

const session = requireGuardianSession();
const NOW     = new Date();
const TODAY   = NOW.toISOString().split('T')[0];
let allIntentions = [];
let calYear   = NOW.getFullYear();
let calMonth  = NOW.getMonth();
let wardStudentId = null;

(function initSidebar() {
  if (!session) return;
  const name = session.name || 'Guardian';
  const initials = name.trim().split(' ').filter(Boolean).map(w=>w[0]).join('').slice(0,2).toUpperCase();
  const av = document.getElementById('userAvatar');
  if (session.profilePic) { av.innerHTML = `<img src="${session.profilePic}" alt="">`; }
  else { av.textContent = initials; }
  document.getElementById('userName').textContent  = name;
  document.getElementById('userEmail').textContent = session.email || '';
})();

document.getElementById('todayDate').textContent      = NOW.toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
document.getElementById('todayPanelDate').textContent = NOW.toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long'});

(function initWard() {
  if (!session) return;
  wardStudentId = session.wardStudentId || session.wardId || null;
  const wardName = session.wardName || 'Your Ward';
  const wardInitials = wardName.trim().split(' ').filter(Boolean).map(w=>w[0]).join('').slice(0,2).toUpperCase();
  document.getElementById('wardAvatar').textContent           = wardInitials;
  document.getElementById('wardName').textContent             = wardName;
  document.getElementById('wardStudentIdDisplay').textContent = wardStudentId ? `ID: ${wardStudentId}` : 'Configure in Settings';
  document.getElementById('wardLabel').textContent            = `Monitoring ${wardName}'s mess activity`;
  if (!wardStudentId) {
    showToast('Ward Student ID not set — showing empty data','var(--danger)');
    setWardStatus('No ward linked','var(--danger)');
  }
})();

function setWardStatus(text, color) {
  document.getElementById('wardStatusDot').style.background = color;
  document.getElementById('wardStatusText').style.color     = color;
  document.getElementById('wardStatusText').textContent     = text;
}

async function loadAllData() {
  if (!wardStudentId) { renderCalendar([]); renderTodayMeals([]); renderStats([]); renderAlerts([]); return; }
  try {
    const res = await fetch(`/api/intentions/student/${wardStudentId}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const raw = await res.json();
    allIntentions = raw.map(i => ({
      date:    (i.date||'').toString().slice(0,10),
      meal:    i.meal || i.mealType || 'lunch',
      willEat: i.willEat !== undefined ? i.willEat : (i.status === 'eating'),
    }));
    renderTodayMeals(allIntentions);
    renderCalendar(allIntentions);
    renderStats(allIntentions);
    renderAlerts(allIntentions);
    const todayMeals = allIntentions.filter(i=>i.date===TODAY);
    const eating = todayMeals.filter(i=>i.willEat).length;
    const total  = todayMeals.length;
    if (total===0) setWardStatus('No data today','var(--muted)');
    else if (eating===total) setWardStatus('All meals marked ✓','var(--accent3)');
    else if (eating>0) setWardStatus(`${eating}/${total} meals eating`,'var(--accent)');
    else setWardStatus('Skipping today','var(--danger)');
  } catch(err) {
    console.error('API Error:', err);
    showToast('Could not load ward data','var(--danger)');
    setWardStatus('Error loading data','var(--danger)');
    renderCalendar([]); renderTodayMeals([]); renderStats([]); renderAlerts([]);
  }
}

function renderTodayMeals(intentions) {
  const MEALS   = ['breakfast','lunch','dinner','snacks'];
  const todayMap = {};
  intentions.filter(i=>i.date===TODAY).forEach(i=>{ todayMap[i.meal] = i.willEat; });
  MEALS.forEach(m => {
    const stateEl = document.getElementById(`meal_${m}_state`);
    const timeEl  = document.getElementById(`meal_${m}_time`);
    const boxEl   = document.getElementById(`box_${m}`);
    if (!stateEl) return;
    if (todayMap[m]===true) { stateEl.className='mb-state eating'; stateEl.innerHTML='✓ Eating'; timeEl.textContent='Marked today'; boxEl.className='meal-box eating'; }
    else if (todayMap[m]===false) { stateEl.className='mb-state skipping'; stateEl.innerHTML='✕ Skipping'; timeEl.textContent='Marked today'; boxEl.className='meal-box skipping'; }
    else { stateEl.className='mb-state pending'; stateEl.innerHTML='⏳ Not marked'; timeEl.textContent='Awaiting student input'; boxEl.className='meal-box'; }
  });
}

function renderStats(intentions) {
  const prefix    = `${NOW.getFullYear()}-${String(NOW.getMonth()+1).padStart(2,'0')}`;
  const thisMonth = intentions.filter(i=>i.date.startsWith(prefix));
  const eating    = thisMonth.filter(i=>i.willEat).length;
  const skipped   = thisMonth.filter(i=>!i.willEat).length;
  const maxPossible  = NOW.getDate() * 4;
  const efficiency   = maxPossible>0 ? Math.round((eating/maxPossible)*100) : 0;
  const consumed     = eating  * MEAL_COST;
  const wasted       = skipped * MEAL_COST;
  const streak       = computeStreak(intentions);
  const set = (id,val) => { const el=document.getElementById(id); if(el) el.textContent=val; };
  set('statMeals',   eating);
  set('statMealsMax',`of ${maxPossible} possible this month`);
  set('statSkipped', skipped);
  set('statWasted',  `₹${wasted.toLocaleString('en-IN')} in skipped meals`);
  set('statEff',     efficiency+'%');
  set('statEffSub',  `₹${consumed.toLocaleString('en-IN')} of ₹${SEMESTER_FEE.toLocaleString('en-IN')}`);
  set('statStreak',  streak);
  const usedPct = Math.min(100, Math.round((consumed/SEMESTER_FEE)*100));
  updateDonut(usedPct, efficiency);
  set('budgetConsumed',  `₹${consumed.toLocaleString('en-IN')}`);
  set('budgetConsumed2', `₹${consumed.toLocaleString('en-IN')}`);
  set('budgetSkipped',   `₹${wasted.toLocaleString('en-IN')}`);
  const monthName = NOW.toLocaleDateString('en-IN',{month:'long',year:'numeric'});
  set('reportTitle', `${monthName} Activity Report`);
  const reportSub = document.getElementById('reportSub');
  if (reportSub) reportSub.textContent = `${eating} meals eaten, ${skipped} skipped. Budget efficiency: ${efficiency}%.`;
}

function computeStreak(intentions) {
  const byDate = {};
  intentions.forEach(i=>{ if(!byDate[i.date]) byDate[i.date]={eat:0,total:0}; byDate[i.date].total++; if(i.willEat) byDate[i.date].eat++; });
  let streak=0;
  const d=new Date(NOW); d.setDate(d.getDate()-1);
  for(let i=0;i<60;i++){
    const key=d.toISOString().split('T')[0];
    const day=byDate[key];
    if(day&&day.eat===4){streak++;d.setDate(d.getDate()-1);}else break;
  }
  return streak;
}

function updateDonut(usedPct, effPct) {
  const arc=document.getElementById('donutArc'),txt=document.getElementById('donutPct');
  if(!arc||!txt) return;
  arc.setAttribute('stroke-dasharray',`${usedPct} ${100-usedPct}`);
  txt.textContent=effPct+'%';
}

function renderCalendar(intentions) {
  const grid=document.getElementById('calGrid');
  if(!grid) return;
  grid.innerHTML='';
  const monthNames=['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('calMonthHead').textContent        = `${monthNames[calMonth]} ${calYear}`;
  document.getElementById('attendancePanelHead').textContent = `Attendance — ${monthNames[calMonth]} ${calYear}`;
  const isCurrentMonth=(calYear===NOW.getFullYear()&&calMonth===NOW.getMonth());
  const todayDate=isCurrentMonth?NOW.getDate():-1;
  const daysInMonth=new Date(calYear,calMonth+1,0).getDate();
  const firstDay=new Date(calYear,calMonth,1).getDay();
  const prevDays=new Date(calYear,calMonth,0).getDate();
  const prefix=`${calYear}-${String(calMonth+1).padStart(2,'0')}`;
  const dayMap={};
  intentions.filter(i=>i.date.startsWith(prefix)).forEach(i=>{ const d=parseInt(i.date.split('-')[2],10); if(!dayMap[d]) dayMap[d]={eat:0,total:0}; dayMap[d].total++; if(i.willEat) dayMap[d].eat++; });
  function getDayClass(d){ const info=dayMap[d]; if(!info||info.total===0) return 'ate'; if(info.eat===info.total) return 'ate'; if(info.eat===0) return 'skipped'; return 'partial'; }
  for(let i=firstDay-1;i>=0;i--){ const el=document.createElement('div');el.className='cal-day other';el.textContent=prevDays-i;grid.appendChild(el); }
  for(let d=1;d<=daysInMonth;d++){
    const el=document.createElement('div');el.className='cal-day';el.textContent=d;
    const thisDate=new Date(calYear,calMonth,d);
    const isFuture=thisDate>NOW;
    const isToday=d===todayDate&&isCurrentMonth;
    if(isToday){ el.classList.add('today'); if(dayMap[d]) el.classList.add(getDayClass(d)); }
    else if(isFuture){ el.classList.add('future'); }
    else { el.classList.add(getDayClass(d)); }
    if(!isFuture&&dayMap[d]){ const info=dayMap[d]; el.title=`${info.eat}/${info.total} meals eaten`; }
    grid.appendChild(el);
  }
  const remainder=(firstDay+daysInMonth)%7===0?0:7-(firstDay+daysInMonth)%7;
  for(let i=1;i<=remainder;i++){ const el=document.createElement('div');el.className='cal-day other';el.textContent=i;grid.appendChild(el); }
}

function calPrev(){ calMonth--; if(calMonth<0){calMonth=11;calYear--;} renderCalendar(allIntentions); }
function calNext(){ calMonth++; if(calMonth>11){calMonth=0;calYear++;} renderCalendar(allIntentions); }

function renderAlerts(intentions) {
  const list=document.getElementById('alertList');
  const badge=document.getElementById('alertBadge');
  if(!list) return;
  const alerts=[];
  const todayIntentions=intentions.filter(i=>i.date===TODAY);
  todayIntentions.filter(i=>!i.willEat).forEach(i=>{ alerts.push({type:'warn',icon:'⚠️',text:`Ward skipped ${i.meal} today`,sub:`${TODAY} — marked as skipping`}); });
  const streak=computeStreak(intentions);
  if(streak>=3) alerts.push({type:'good',icon:'🔥',text:`${streak}-day full attendance streak!`,sub:'All meals eaten consistently'});
  const last7=[];
  for(let i=1;i<=7;i++){ const d=new Date(NOW); d.setDate(d.getDate()-i); last7.push(d.toISOString().split('T')[0]); }
  const recentSkips=intentions.filter(i=>last7.includes(i.date)&&!i.willEat).length;
  if(recentSkips>=5) alerts.push({type:'bad',icon:'📉',text:`${recentSkips} meals skipped in last 7 days`,sub:'Ward may need follow-up'});
  const totalEaten=intentions.filter(i=>i.willEat).length;
  const consumed=totalEaten*MEAL_COST;
  const pct=Math.round((consumed/SEMESTER_FEE)*100);
  if(pct>=80) alerts.push({type:'warn',icon:'💰',text:`${pct}% of semester mess fee consumed`,sub:`₹${consumed.toLocaleString('en-IN')} of ₹${SEMESTER_FEE.toLocaleString('en-IN')}`});
  const prevMonth=new Date(NOW.getFullYear(),NOW.getMonth()-1,1).toLocaleDateString('en-IN',{month:'long',year:'numeric'});
  alerts.push({type:'info',icon:'📊',text:`${prevMonth} report available`,sub:'Download CSV from report section below'});
  if(badge) badge.textContent=alerts.length;
  if(alerts.length===0){ list.innerHTML=`<div class="state-box">No alerts — all good! ✅</div>`; return; }
  list.innerHTML=alerts.map(a=>`<div class="alert-item"><div class="alert-icon ${a.type}">${a.icon}</div><div><div class="alert-text">${a.text}</div><div class="alert-sub">${a.sub}</div></div></div>`).join('');
}

function exportAttendanceCSV() {
  if(!allIntentions.length){ showToast('No data to export','var(--danger)'); return; }
  const rows=[['Date','Meal','Status','Cost (₹)']];
  allIntentions.sort((a,b)=>a.date.localeCompare(b.date)).forEach(i=>{ rows.push([i.date,i.meal,i.willEat?'Eating':'Skipping',i.willEat?MEAL_COST:0]); });
  downloadCSV(rows,`ward_attendance_${TODAY}.csv`);
  showToast('Attendance CSV downloaded!','var(--accent3)');
}

function downloadReport() {
  if(!allIntentions.length){ showToast('No data available','var(--danger)'); return; }
  const rows=[['Date','Meal','Status','Cost (₹)']];
  allIntentions.sort((a,b)=>a.date.localeCompare(b.date)).forEach(i=>{ rows.push([i.date,i.meal,i.willEat?'Eating':'Skipping',i.willEat?MEAL_COST:0]); });
  const total=allIntentions.filter(i=>i.willEat).length*MEAL_COST;
  rows.push(['','','Total Consumed',total]);
  downloadCSV(rows,`ward_report_${TODAY}.csv`);
  showToast('Report downloaded!','var(--accent)');
}

function downloadCSV(rows, filename) {
  const csv=rows.map(r=>r.join(',')).join('\n');
  const a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
  a.download=filename; a.click();
}

function showToast(msg,color){
  const w=document.getElementById('toastWrap'),t=document.createElement('div');
  t.className='toast';
  t.innerHTML=`<div class="toast-dot" style="background:${color||'var(--accent)'}"></div><span>${msg}</span>`;
  w.appendChild(t);
  requestAnimationFrame(()=>requestAnimationFrame(()=>{ t.classList.add('show'); }));
  setTimeout(()=>{ t.classList.remove('show'); setTimeout(()=>t.remove(),350); },2800);
}

function toggleSidebar(){
  const s=document.getElementById('sidebar'),o=document.getElementById('overlay'),open=s.classList.toggle('open');
  o.style.display=open?'block':'none';
}

document.addEventListener('DOMContentLoaded',()=>{ loadAllData(); });
</script>
</body>
</html>
