<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MessMate | Guardian Budget</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
:root{
  --bg:#0a0d0f;--surface:#111518;--surface2:#181d21;--surface3:#1e2428;
  --border:rgba(255,255,255,0.07);--text:#e8edf2;--muted:#7a8a96;
  --accent:#f4c542;--accent2:#00b8ff;--accent3:#00e5a0;--danger:#ff4757;
  --sidebar:220px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);display:flex;overflow:hidden}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--surface3);border-radius:2px}
.sidebar{width:var(--sidebar);flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;height:100vh;position:sticky;top:0;overflow-y:auto}
.sidebar-logo{padding:24px 20px 20px;border-bottom:1px solid var(--border)}
.logo-text{font-weight:800;font-size:1.25rem;color:var(--accent);text-decoration:none;display:block}
.logo-text span{color:var(--text)}
.logo-sub{font-size:0.65rem;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-top:2px}
.sidebar-user{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.user-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2a1f04,#f4c542);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.78rem;color:rgba(10,13,15,0.9);flex-shrink:0;overflow:hidden}
.user-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.user-name{font-size:0.82rem;font-weight:500}
.sidebar-nav{flex:1;padding:12px;display:flex;flex-direction:column;gap:2px}
.nav-label{font-size:0.62rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);padding:10px 8px 6px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;text-decoration:none;color:var(--muted);font-size:0.85rem;font-weight:500;transition:all 0.18s;position:relative;cursor:pointer}
.nav-item:hover{background:var(--surface2);color:var(--text)}
.nav-item.active{background:rgba(244,197,66,0.08);color:var(--accent)}
.nav-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:2px;border-radius:0 2px 2px 0;background:var(--accent)}
.nav-icon{font-size:1rem;width:20px;text-align:center;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--accent);color:#0a0d0f;font-size:0.6rem;font-weight:800;padding:1px 6px;border-radius:100px}
.sidebar-bottom{padding:12px;border-top:1px solid var(--border)}
.logout-btn{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;color:var(--muted);font-size:0.82rem;cursor:pointer;transition:all 0.18s;text-decoration:none}
.logout-btn:hover{color:var(--danger);background:rgba(255,71,87,0.06)}
.main{flex:1;overflow-y:auto;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:50;background:rgba(10,13,15,0.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:14px 32px;display:flex;align-items:center;justify-content:space-between}
.topbar h1{font-size:1.1rem;font-weight:800;letter-spacing:-0.3px}
.topbar p{font-size:0.78rem;color:var(--muted);margin-top:1px}
.topbar-right{display:flex;align-items:center;gap:10px}
.tb-btn{height:34px;padding:0 14px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--muted);font-size:0.78rem;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all 0.18s;font-family:'Poppins',sans-serif}
.tb-btn:hover{border-color:var(--accent);color:var(--accent)}
.tb-btn.primary{background:var(--accent);border-color:var(--accent);color:#0a0d0f;font-weight:700}
.tb-btn.primary:hover{opacity:0.88}
.mobile-menu-btn{display:none;width:34px;height:34px;border-radius:8px;background:var(--surface2);border:1px solid var(--border);align-items:center;justify-content:center;cursor:pointer;font-size:1rem}
.content{padding:28px 32px;flex:1}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:16px}
.panel-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.panel-head h3{font-size:0.85rem;font-weight:700}
.panel-action{font-size:0.72rem;color:var(--accent);cursor:pointer;text-decoration:none;transition:opacity 0.2s}
.panel-action:hover{opacity:0.7}
.panel-body{padding:18px}
.budget-hero{background:linear-gradient(135deg,rgba(244,197,66,0.08) 0%,rgba(0,184,255,0.05) 50%,rgba(0,229,160,0.04) 100%);border:1px solid rgba(244,197,66,0.2);border-radius:20px;padding:28px 32px;margin-bottom:20px;position:relative;overflow:hidden}
.budget-hero::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(244,197,66,0.08),transparent 70%);pointer-events:none}
.hero-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px}
.hero-ward{display:flex;align-items:center;gap:12px}
.hero-av{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#2a1f04,#f4c542);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.9rem;color:rgba(10,13,15,0.9)}
.hero-name{font-weight:800;font-size:1rem}
.hero-sub{font-size:0.72rem;color:var(--muted);margin-top:2px}
.hero-period{font-size:0.72rem;color:var(--muted);background:var(--surface2);border:1px solid var(--border);padding:5px 12px;border-radius:8px}
.big-nums{display:grid;grid-template-columns:repeat(3,1fr);gap:0}
.big-num{padding:0 28px;border-right:1px solid var(--border)}
.big-num:first-child{padding-left:0}
.big-num:last-child{border-right:none}
.bn-label{font-size:0.7rem;color:var(--muted);font-weight:500;margin-bottom:6px;letter-spacing:0.3px}
.bn-val{font-size:2.2rem;font-weight:800;letter-spacing:-1.5px;line-height:1}
.bn-sub{font-size:0.7rem;color:var(--muted);margin-top:5px}
.bn-pill{display:inline-flex;align-items:center;gap:3px;font-size:0.65rem;font-weight:700;padding:2px 7px;border-radius:100px;margin-top:4px}
.fee-progress{margin-top:22px}
.fp-top{display:flex;justify-content:space-between;margin-bottom:8px}
.fp-label{font-size:0.72rem;color:var(--muted)}
.fp-pct{font-size:0.72rem;font-weight:700;color:var(--accent)}
.fp-track{height:8px;border-radius:4px;background:var(--surface3);overflow:hidden;position:relative}
.fp-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),#ffb300);transition:width 1.2s cubic-bezier(0.22,1,0.36,1)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px}
.stat-label{font-size:0.7rem;color:var(--muted);margin-bottom:8px;font-weight:500}
.stat-val{font-size:1.7rem;font-weight:800;letter-spacing:-1px;line-height:1;margin-bottom:5px}
.stat-sub{font-size:0.68rem;color:var(--muted)}
.month-tabs{display:flex;gap:6px;margin-bottom:20px;overflow-x:auto;padding-bottom:4px}
.month-tab{padding:7px 16px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--muted);font-size:0.78rem;font-weight:500;cursor:pointer;transition:all 0.18s;white-space:nowrap;font-family:'Poppins',sans-serif}
.month-tab:hover{border-color:rgba(244,197,66,0.3);color:var(--text)}
.month-tab.active{background:rgba(244,197,66,0.1);border-color:rgba(244,197,66,0.4);color:var(--accent);font-weight:600}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.donut-wrap{display:flex;align-items:center;gap:24px}
.donut-svg{width:110px;height:110px;flex-shrink:0}
.donut-legend{display:flex;flex-direction:column;gap:10px;flex:1}
.dl-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.dl-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dl-label{font-size:0.76rem;color:var(--muted);flex:1}
.dl-val{font-size:0.8rem;font-weight:600}
.dl-pct{font-size:0.68rem;color:var(--muted);min-width:32px;text-align:right}
.bar-chart{display:flex;flex-direction:column;gap:10px}
.bc-row{display:flex;align-items:center;gap:10px}
.bc-label{font-size:0.72rem;color:var(--muted);width:70px;flex-shrink:0;text-align:right}
.bc-track{flex:1;height:22px;border-radius:6px;background:var(--surface2);overflow:hidden;position:relative}
.bc-fill{height:100%;border-radius:6px;display:flex;align-items:center;padding-left:8px;font-size:0.65rem;font-weight:700;color:#0a0d0f;transition:width 1s cubic-bezier(0.22,1,0.36,1);min-width:0}
.bc-val{font-size:0.72rem;font-weight:600;width:50px;text-align:right;flex-shrink:0}
table{width:100%;border-collapse:collapse}
thead th{font-size:0.65rem;font-weight:600;color:var(--muted);letter-spacing:0.8px;text-transform:uppercase;padding:8px 10px;border-bottom:1px solid var(--border);text-align:left}
tbody tr{border-bottom:1px solid var(--border);transition:background 0.15s}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:var(--surface2)}
tbody td{padding:10px;font-size:0.78rem}
.pill{font-size:0.62rem;font-weight:700;padding:2px 8px;border-radius:100px}
.pill-green{background:rgba(0,229,160,0.1);color:var(--accent3)}
.pill-red{background:rgba(255,71,87,0.1);color:var(--danger)}
.pill-gold{background:rgba(244,197,66,0.1);color:var(--accent)}
.pill-blue{background:rgba(0,184,255,0.1);color:var(--accent2)}
.proj-card{background:linear-gradient(135deg,rgba(0,184,255,0.06),rgba(0,229,160,0.04));border:1px solid rgba(0,184,255,0.18);border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:20px;margin-bottom:16px}
.proj-icon{font-size:2rem;flex-shrink:0}
.proj-title{font-weight:800;font-size:0.9rem;margin-bottom:4px}
.proj-sub{font-size:0.74rem;color:var(--muted);line-height:1.5}
.proj-right{margin-left:auto;text-align:right;flex-shrink:0}
.proj-val{font-weight:800;font-size:1.6rem;letter-spacing:-1px;color:var(--accent2)}
.proj-vsub{font-size:0.68rem;color:var(--muted);margin-top:2px}
.state-box{padding:32px;text-align:center;color:var(--muted);font-size:0.8rem}
.spinner{width:24px;height:24px;border:2px solid var(--surface3);border-top-color:var(--accent);border-radius:50%;animation:spin 0.7s linear infinite;margin:0 auto 12px}
@keyframes spin{to{transform:rotate(360deg)}}
.toast-wrap{position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:10px;font-size:0.82rem;min-width:240px;box-shadow:0 8px 32px rgba(0,0,0,0.5);transform:translateY(8px);opacity:0;transition:all 0.35s cubic-bezier(0.22,1,0.36,1);pointer-events:all}
.toast.show{transform:translateY(0);opacity:1}
.toast-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
#overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:199}
@media(max-width:1100px){.stats-grid{grid-template-columns:1fr 1fr}.big-nums{grid-template-columns:1fr 1fr}}
@media(max-width:900px){
  .sidebar{position:fixed;left:-100%;top:0;z-index:200;transition:left 0.3s;width:240px}
  .sidebar.open{left:0}.mobile-menu-btn{display:flex}
  .two-col{grid-template-columns:1fr}.stats-grid{grid-template-columns:1fr 1fr}
  .content{padding:20px 16px}.topbar{padding:14px 16px}
  .big-nums{grid-template-columns:1fr 1fr;gap:16px}
  .big-num{padding:0;border-right:none;border-bottom:1px solid var(--border);padding-bottom:16px}
  .big-num:last-child{border-bottom:none;padding-bottom:0}
}
@media(max-width:560px){.stats-grid{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <a href="/guardian/dashboard" class="logo-text">Mess<span>Mate</span></a>
    <div class="logo-sub">Guardian Portal</div>
  </div>
  <div class="sidebar-user">
    <div class="user-avatar" id="userAvatar">?</div>
    <div>
      <div class="user-name" id="userName">Loading…</div>
      <div style="font-size:0.68rem;color:var(--muted)">Parent / Guardian</div>
      <div style="font-size:0.6rem;color:var(--muted);margin-top:1px;word-break:break-all" id="userEmail"></div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-label">Overview</div>
    <a class="nav-item" href="/guardian/dashboard"><span class="nav-icon">🏠</span> Dashboard</a>
    <a class="nav-item" href="#"><span class="nav-icon">📅</span> Attendance</a>
    <a class="nav-item active" href="/guardian/budget"><span class="nav-icon">💰</span> Budget</a>
    <a class="nav-item" href="#"><span class="nav-icon">📊</span> Reports <span class="nav-badge">1</span></a>
    <div class="nav-label">Alerts</div>
    <a class="nav-item" href="#"><span class="nav-icon">🔔</span> Notifications</a>
    <a class="nav-item" href="#"><span class="nav-icon">⚙️</span> Preferences</a>
  </nav>
  <div class="sidebar-bottom">
    <a class="logout-btn" href="/login" onclick="sessionStorage.removeItem('mm_session')">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign Out
    </a>
  </div>
</aside>

<div class="main">
  <div class="topbar">
    <div>
      <h1>Budget Overview</h1>
      <p id="wardLabel">Ward's mess fee & consumption details</p>
    </div>
    <div class="topbar-right">
      <button class="tb-btn" onclick="exportCSV()">⬇ Export CSV</button>
      <button class="tb-btn primary" onclick="showToast('Budget report sent to email!','var(--accent3)')">📧 Email Report</button>
      <div class="mobile-menu-btn" onclick="toggleSidebar()">☰</div>
    </div>
  </div>

  <div class="content">
    <div class="budget-hero">
      <div class="hero-top">
        <div class="hero-ward">
          <div class="hero-av" id="heroAvatar">?</div>
          <div>
            <div class="hero-name" id="heroName">Loading…</div>
            <div class="hero-sub">Mess Fee Tracker · <span id="academicYear">—</span></div>
          </div>
        </div>
        <div class="hero-period" id="heroPeriod">—</div>
      </div>
      <div class="big-nums">
        <div class="big-num">
          <div class="bn-label">SEMESTER FEE</div>
          <div class="bn-val" style="color:var(--text)" id="bnFee">₹—</div>
          <div class="bn-sub">Total mess fee paid</div>
        </div>
        <div class="big-num">
          <div class="bn-label">CONSUMED</div>
          <div class="bn-val" style="color:var(--accent)" id="bnConsumed">₹—</div>
          <div class="bn-sub" id="bnConsumedSub">calculating…</div>
          <div class="bn-pill" id="bnConsumedPill" style="background:rgba(244,197,66,0.1);color:var(--accent)">—%</div>
        </div>
        <div class="big-num">
          <div class="bn-label">WASTED (SKIPPED)</div>
          <div class="bn-val" style="color:var(--danger)" id="bnWasted">₹—</div>
          <div class="bn-sub" id="bnWastedSub">calculating…</div>
          <div class="bn-pill" id="bnWastedPill" style="background:rgba(255,71,87,0.1);color:var(--danger)">—%</div>
        </div>
      </div>
      <div class="fee-progress">
        <div class="fp-top">
          <span class="fp-label">Fee utilization</span>
          <span class="fp-pct" id="fpPct">0%</span>
        </div>
        <div class="fp-track">
          <div class="fp-fill" id="fpFill" style="width:0%"></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:6px">
          <span style="font-size:0.65rem;color:var(--muted)">₹0</span>
          <span style="font-size:0.65rem;color:var(--muted)" id="fpMax">₹—</span>
        </div>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-label">Per Meal Value</div><div class="stat-val" style="color:var(--accent2)" id="scPerMeal">₹—</div><div class="stat-sub">Cost per meal serving</div></div>
      <div class="stat-card"><div class="stat-label">Meals Eaten</div><div class="stat-val" style="color:var(--accent3)" id="scEaten">—</div><div class="stat-sub" id="scEatenSub">all time</div></div>
      <div class="stat-card"><div class="stat-label">Meals Skipped</div><div class="stat-val" style="color:var(--danger)" id="scSkipped">—</div><div class="stat-sub" id="scSkippedSub">₹— wasted</div></div>
      <div class="stat-card"><div class="stat-label">Efficiency Score</div><div class="stat-val" style="color:var(--accent)" id="scEfficiency">—</div><div class="stat-sub" id="scEffSub">budget utilization</div></div>
    </div>

    <div class="month-tabs" id="monthTabs"></div>

    <div class="proj-card" id="projCard">
      <div class="proj-icon">🔮</div>
      <div>
        <div class="proj-title">Projected Month-End Spend</div>
        <div class="proj-sub" id="projSub">Calculating based on current eating pattern…</div>
      </div>
      <div class="proj-right">
        <div class="proj-val" id="projVal">₹—</div>
        <div class="proj-vsub" id="projVsub">by month end</div>
      </div>
    </div>

    <div class="two-col">
      <div class="panel">
        <div class="panel-head"><h3>Meal Breakdown</h3><span class="panel-action" id="donutPeriodLabel">This Month</span></div>
        <div class="panel-body">
          <div class="donut-wrap">
            <svg class="donut-svg" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="14" fill="none" stroke="#1e2428" stroke-width="4.5"/>
              <circle id="arc_breakfast" cx="18" cy="18" r="14" fill="none" stroke="#f4c542" stroke-width="4.5" stroke-dasharray="0 100" stroke-dashoffset="25" stroke-linecap="butt" style="transition:stroke-dasharray 1s ease"/>
              <circle id="arc_lunch" cx="18" cy="18" r="14" fill="none" stroke="#00b8ff" stroke-width="4.5" stroke-dasharray="0 100" stroke-dashoffset="25" stroke-linecap="butt" style="transition:stroke-dasharray 1s ease"/>
              <circle id="arc_dinner" cx="18" cy="18" r="14" fill="none" stroke="#00e5a0" stroke-width="4.5" stroke-dasharray="0 100" stroke-dashoffset="25" stroke-linecap="butt" style="transition:stroke-dasharray 1s ease"/>
              <circle id="arc_snacks" cx="18" cy="18" r="14" fill="none" stroke="#ff6b35" stroke-width="4.5" stroke-dasharray="0 100" stroke-dashoffset="25" stroke-linecap="butt" style="transition:stroke-dasharray 1s ease"/>
              <text x="18" y="17" text-anchor="middle" font-size="5" fill="#7a8a96" font-family="Poppins">eaten</text>
              <text x="18" y="22" text-anchor="middle" font-size="6.5" fill="#e8edf2" font-family="Poppins" font-weight="800" id="donutCenter">—</text>
            </svg>
            <div class="donut-legend">
              <div class="dl-row"><div class="dl-dot" style="background:#f4c542"></div><span class="dl-label">Breakfast</span><span class="dl-val" id="lg_breakfast">—</span><span class="dl-pct" id="lgp_breakfast">—</span></div>
              <div class="dl-row"><div class="dl-dot" style="background:#00b8ff"></div><span class="dl-label">Lunch</span><span class="dl-val" id="lg_lunch">—</span><span class="dl-pct" id="lgp_lunch">—</span></div>
              <div class="dl-row"><div class="dl-dot" style="background:#00e5a0"></div><span class="dl-label">Dinner</span><span class="dl-val" id="lg_dinner">—</span><span class="dl-pct" id="lgp_dinner">—</span></div>
              <div class="dl-row"><div class="dl-dot" style="background:#ff6b35"></div><span class="dl-label">Snacks</span><span class="dl-val" id="lg_snacks">—</span><span class="dl-pct" id="lgp_snacks">—</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><h3>Monthly Spend</h3><span class="panel-action">Per meal ₹<span id="perMealLabel">—</span></span></div>
        <div class="panel-body">
          <div class="bar-chart" id="barChart"><div class="state-box"><div class="spinner"></div>Loading…</div></div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3>Meal Log — <span id="logPeriodLabel" style="color:var(--muted);font-weight:500">This Month</span></h3>
        <a href="#" class="panel-action" onclick="exportCSV();return false">Export →</a>
      </div>
      <div class="panel-body" style="padding:0">
        <div id="mealLogWrap"><div class="state-box"><div class="spinner"></div>Fetching meal data…</div></div>
      </div>
    </div>
  </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>
<div id="overlay" onclick="toggleSidebar()"></div>

<script>
// ✅ let — so we can update from API
let MEAL_COST    = 67;
let SEMESTER_FEE = 6000;

const MEALS       = ['breakfast','lunch','dinner','snacks'];
const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const NOW         = new Date();

function requireGuardianSession() {
  try {
    const s = JSON.parse(sessionStorage.getItem('mm_session'));
    if (!s) { window.location.href = '/login'; return null; }
    if (s.role !== 'guardian') {
      const map = { student: '/student/dashboard', admin: '/admin/dashboard' };
      window.location.href = map[s.role] || '/login';
      return null;
    }
    return s;
  } catch(e) { window.location.href = '/login'; return null; }
}

const session = requireGuardianSession();
let allData    = [];
let activeMonth = `${NOW.getFullYear()}-${String(NOW.getMonth()+1).padStart(2,'0')}`;
let wardStudentId = null;

(function(){
  if (!session) return;
  const name     = session.name || 'Guardian';
  const initials = name.trim().split(' ').filter(Boolean).map(w=>w[0]).join('').slice(0,2).toUpperCase();
  const av = document.getElementById('userAvatar');
  if (session.profilePic) av.innerHTML = `<img src="${session.profilePic}" alt="">`;
  else av.textContent = initials;
  document.getElementById('userName').textContent  = name;
  document.getElementById('userEmail').textContent = session.email || '';

  wardStudentId = session.wardStudentId || session.wardId || null;
  const wardName     = session.wardName || 'Your Ward';
  const wardInitials = wardName.trim().split(' ').filter(Boolean).map(w=>w[0]).join('').slice(0,2).toUpperCase();
  document.getElementById('heroAvatar').textContent = wardInitials;
  document.getElementById('heroName').textContent   = wardName;
  document.getElementById('wardLabel').textContent  = `${wardName}'s mess fee & consumption`;
  document.getElementById('academicYear').textContent = `${NOW.getFullYear()}–${NOW.getFullYear()+1}`;
  document.getElementById('heroPeriod').textContent = `${MONTH_NAMES[NOW.getMonth()]} ${NOW.getFullYear()}`;
})();

async function loadData() {
  if (!wardStudentId) {
    showToast('Ward Student ID not found in session', 'var(--danger)');
    renderAll([]);
    return;
  }
  try {
    // ✅ Dono APIs ek saath call karo
    const [intentRes, budgetRes] = await Promise.all([
      fetch(`/api/intentions/student/${wardStudentId}`),
      fetch('/api/budget')
    ]);

    const raw    = await intentRes.json();
    const budget = await budgetRes.json();

    // ✅ Admin ke set kiye values use karo
    MEAL_COST    = budget.perMealCostAvg        || budget.perMealCostTarget || 67;
    SEMESTER_FEE = budget.semesterFeePerStudent  || 6000;

    // ✅ UI update karo
    document.getElementById('bnFee').textContent      = fmt(SEMESTER_FEE);
    document.getElementById('fpMax').textContent      = fmt(SEMESTER_FEE);
    document.getElementById('scPerMeal').textContent  = '₹' + MEAL_COST;
    document.getElementById('perMealLabel').textContent = MEAL_COST;

    allData = raw.map(i => ({
      date:    (i.date || '').toString().slice(0, 10),
      meal:    i.meal || i.mealType || 'lunch',
      willEat: i.willEat !== undefined ? i.willEat : (i.status === 'eating'),
    }));

    buildMonthTabs();
    renderAll(filterByMonth(activeMonth));
  } catch (err) {
    console.error(err);
    showToast('Could not load data — check API', 'var(--danger)');
    renderAll([]);
  }
}

function filterByMonth(prefix) { return allData.filter(i => i.date.startsWith(prefix)); }

function buildMonthTabs() {
  const months = [...new Set(allData.map(i => i.date.slice(0,7)))].sort().reverse();
  const cur = `${NOW.getFullYear()}-${String(NOW.getMonth()+1).padStart(2,'0')}`;
  if (!months.includes(cur)) months.unshift(cur);
  const wrap = document.getElementById('monthTabs');
  wrap.innerHTML = months.map(m => {
    const [y, mo] = m.split('-');
    const label = `${MONTH_NAMES[parseInt(mo)-1].slice(0,3)} ${y}`;
    return `<button class="month-tab${m === activeMonth ? ' active':''}" onclick="selectMonth('${m}',this)">${label}</button>`;
  }).join('');
}

function selectMonth(m, el) {
  activeMonth = m;
  document.querySelectorAll('.month-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  const data = filterByMonth(m);
  renderAll(data);
  const [y, mo] = m.split('-');
  const label = `${MONTH_NAMES[parseInt(mo)-1]} ${y}`;
  document.getElementById('logPeriodLabel').textContent  = label;
  document.getElementById('donutPeriodLabel').textContent = label;
  document.getElementById('heroPeriod').textContent      = label;
}

function renderAll(data) { renderHero(data); renderStats(data); renderDonut(data); renderBarChart(); renderMealLog(data); renderProjection(data); }

function renderHero(data) {
  const eaten   = data.filter(i => i.willEat).length;
  const skipped = data.filter(i => !i.willEat).length;
  const consumed = eaten * MEAL_COST;
  const wasted   = skipped * MEAL_COST;
  const pctConsumed = SEMESTER_FEE > 0 ? Math.round((consumed / SEMESTER_FEE) * 100) : 0;
  const pctWasted   = SEMESTER_FEE > 0 ? Math.round((wasted  / SEMESTER_FEE) * 100) : 0;
  set('bnConsumed', fmt(consumed));
  set('bnConsumedSub', `${eaten} meals eaten this period`);
  set('bnConsumedPill', `${pctConsumed}% of fee`);
  set('bnWasted', fmt(wasted));
  set('bnWastedSub', `${skipped} meals skipped`);
  set('bnWastedPill', `${pctWasted}% wasted`);
  set('fpPct', `${pctConsumed}%`);
  setTimeout(() => {
    const fill = document.getElementById('fpFill');
    fill.style.width = Math.min(pctConsumed, 100) + '%';
    if (pctConsumed >= 80) fill.style.background = 'linear-gradient(90deg,var(--accent3),#00cc7a)';
    else if (pctConsumed >= 50) fill.style.background = 'linear-gradient(90deg,var(--accent),#ffb300)';
    else fill.style.background = 'linear-gradient(90deg,var(--danger),#ff6b35)';
  }, 100);
}

function renderStats(data) {
  const eaten   = data.filter(i => i.willEat).length;
  const skipped = data.filter(i => !i.willEat).length;
  const total   = data.length;
  const eff     = total > 0 ? Math.round((eaten / total) * 100) : 0;
  set('scEaten',     eaten);
  set('scEatenSub',  `₹${(eaten*MEAL_COST).toLocaleString('en-IN')} consumed`);
  set('scSkipped',   skipped);
  set('scSkippedSub',`₹${(skipped*MEAL_COST).toLocaleString('en-IN')} wasted`);
  set('scEfficiency', eff+'%');
  set('scEffSub',    eff>=80?'🟢 Excellent':eff>=60?'🟡 Average':'🔴 Low');
}

function renderDonut(data) {
  const byMeal = { breakfast:0, lunch:0, dinner:0, snacks:0 };
  data.filter(i => i.willEat).forEach(i => { if (byMeal[i.meal] !== undefined) byMeal[i.meal]++; });
  const totalEaten = Object.values(byMeal).reduce((a,b) => a+b, 0);
  set('donutCenter', totalEaten);
  let offset = 25;
  MEALS.forEach(m => {
    const pct = totalEaten > 0 ? (byMeal[m] / totalEaten) * 100 : 0;
    const arc = document.getElementById(`arc_${m}`);
    if (arc) { arc.setAttribute('stroke-dasharray', `${pct} ${100-pct}`); arc.setAttribute('stroke-dashoffset', offset); offset -= pct; }
    set(`lg_${m}`,  byMeal[m]+' meals');
    set(`lgp_${m}`, totalEaten>0?Math.round(pct)+'%':'0%');
  });
}

function renderBarChart() {
  const container = document.getElementById('barChart');
  const months = [...new Set(allData.map(i => i.date.slice(0,7)))].sort().slice(-6);
  const cur = `${NOW.getFullYear()}-${String(NOW.getMonth()+1).padStart(2,'0')}`;
  if (!months.includes(cur)) months.push(cur);
  if (!months.length) { container.innerHTML='<div class="state-box">No data available</div>'; return; }
  const monthData = months.map(m => {
    const d=allData.filter(i=>i.date.startsWith(m));
    const eaten=d.filter(i=>i.willEat).length;
    return {month:m, eaten, spend:eaten*MEAL_COST};
  });
  const maxSpend = Math.max(...monthData.map(d=>d.spend), 1);
  container.innerHTML = monthData.map(d => {
    const [y,mo] = d.month.split('-');
    const label = MONTH_NAMES[parseInt(mo)-1].slice(0,3);
    const widthPct = Math.round((d.spend/maxSpend)*100);
    const isActive = d.month === activeMonth;
    return `<div class="bc-row"><span class="bc-label">${label} '${y.slice(2)}</span><div class="bc-track"><div class="bc-fill" id="bar_${d.month}" style="width:0%;background:${isActive?'var(--accent)':'rgba(0,184,255,0.7)'};color:${isActive?'#0a0d0f':'#e8edf2'}" data-w="${widthPct}">${widthPct>15?fmt(d.spend):''}</div></div><span class="bc-val" style="color:${isActive?'var(--accent)':'var(--muted)'}">${fmt(d.spend)}</span></div>`;
  }).join('');
  setTimeout(() => { document.querySelectorAll('.bc-fill').forEach(el => { el.style.width = el.dataset.w+'%'; }); }, 150);
}

function renderProjection(data) {
  const today    = NOW.getDate();
  const daysLeft = new Date(NOW.getFullYear(), NOW.getMonth()+1, 0).getDate() - today;
  const eaten    = data.filter(i => i.willEat).length;
  const cur      = `${NOW.getFullYear()}-${String(NOW.getMonth()+1).padStart(2,'0')}`;
  if (activeMonth !== cur) { document.getElementById('projCard').style.display='none'; return; }
  document.getElementById('projCard').style.display='flex';
  const dailyRate      = today > 0 ? eaten/today : 0;
  const projected      = Math.round(eaten + dailyRate*daysLeft) * MEAL_COST;
  const projectedMeals = Math.round(eaten + dailyRate*daysLeft);
  set('projVal',  fmt(projected));
  set('projVsub', `~${projectedMeals} total meals by month end`);
  const eff = SEMESTER_FEE>0 ? Math.round((projected/SEMESTER_FEE)*100) : 0;
  set('projSub', `Based on ${dailyRate.toFixed(1)} meals/day rate. Projected ${eff}% of semester fee utilization. ${eff>=85?'✅ On track!':eff<60?'⚠️ Low utilization':'📊 Moderate'}`);
}

function renderMealLog(data) {
  const wrap = document.getElementById('mealLogWrap');
  if (!data.length) { wrap.innerHTML='<div class="state-box">No meal data for this period</div>'; return; }
  const byDate = {};
  data.forEach(i => { if(!byDate[i.date]) byDate[i.date]={}; byDate[i.date][i.meal]=i.willEat; });
  const rows = Object.entries(byDate).sort(([a],[b])=>b.localeCompare(a)).map(([date,meals]) => {
    const eaten   = Object.values(meals).filter(Boolean).length;
    const skipped = Object.values(meals).filter(v=>!v).length;
    const daySpend = eaten*MEAL_COST;
    const d = new Date(date+'T00:00:00');
    const dateStr = d.toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'});
    const mealPills = MEALS.map(m => {
      if (meals[m]===undefined) return `<span class="pill" style="background:var(--surface3);color:var(--muted)">—</span>`;
      return meals[m]?`<span class="pill pill-green">✓ ${m.slice(0,1).toUpperCase()+m.slice(1)}</span>`:`<span class="pill pill-red">✕ ${m.slice(0,1).toUpperCase()+m.slice(1)}</span>`;
    }).join(' ');
    const effPill = eaten===4?`<span class="pill pill-green">All meals</span>`:skipped===4?`<span class="pill pill-red">Skipped all</span>`:`<span class="pill pill-gold">Partial</span>`;
    return `<tr><td style="font-weight:500">${dateStr}</td><td>${mealPills}</td><td style="text-align:center">${effPill}</td><td style="text-align:right;font-weight:700;color:${eaten>0?'var(--accent3)':'var(--muted)'}">${fmt(daySpend)}</td></tr>`;
  }).join('');
  const totalSpend   = data.filter(i=>i.willEat).length*MEAL_COST;
  const totalEaten   = data.filter(i=>i.willEat).length;
  const totalSkipped = data.filter(i=>!i.willEat).length;
  wrap.innerHTML=`<div style="overflow-x:auto"><table><thead><tr><th>Date</th><th>Meals</th><th style="text-align:center">Status</th><th style="text-align:right">Spend</th></tr></thead><tbody>${rows}</tbody><tfoot><tr style="border-top:2px solid var(--border)"><td style="font-weight:700;padding:12px 10px">Total</td><td style="font-size:0.75rem;color:var(--muted);padding:12px 10px">${totalEaten} eaten · ${totalSkipped} skipped</td><td></td><td style="text-align:right;font-weight:800;font-size:1rem;color:var(--accent);padding:12px 10px">${fmt(totalSpend)}</td></tr></tfoot></table></div>`;
}

function exportCSV() {
  const data = filterByMonth(activeMonth);
  if (!data.length) { showToast('No data to export','var(--danger)'); return; }
  const rows=[['Date','Meal','Status','Cost (₹)']];
  data.sort((a,b)=>a.date.localeCompare(b.date)).forEach(i=>{ rows.push([i.date,i.meal,i.willEat?'Eating':'Skipping',i.willEat?MEAL_COST:0]); });
  const total=data.filter(i=>i.willEat).length*MEAL_COST;
  rows.push(['','','Total Consumed',total]);
  const csv=rows.map(r=>r.join(',')).join('\n');
  const a=document.createElement('a'); a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv); a.download=`budget_${activeMonth}.csv`; a.click();
  showToast('CSV downloaded!','var(--accent3)');
}

function set(id,val){ const el=document.getElementById(id); if(el) el.textContent=val; }
function fmt(n){ return '₹'+Number(n).toLocaleString('en-IN'); }

function showToast(msg,color){
  const w=document.getElementById('toastWrap'),t=document.createElement('div');
  t.className='toast';
  t.innerHTML=`<div class="toast-dot" style="background:${color||'var(--accent)'}"></div><span>${msg}</span>`;
  w.appendChild(t);
  requestAnimationFrame(()=>requestAnimationFrame(()=>t.classList.add('show')));
  setTimeout(()=>{t.classList.remove('show');setTimeout(()=>t.remove(),350);},2800);
}

function toggleSidebar(){
  const s=document.getElementById('sidebar'),o=document.getElementById('overlay');
  s.classList.toggle('open');
  o.style.display=s.classList.contains('open')?'block':'none';
}

document.addEventListener('DOMContentLoaded', loadData);
</script>
</body>
</html>
