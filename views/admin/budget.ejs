<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MessMate | Admin Budget</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .semester-bar { margin-bottom: 24px; }
    .sb-row   { display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 6px; }
    .sb-track { height: 12px; border-radius: 6px; background: var(--surface2); overflow: hidden; position: relative; }
    .sb-fill  { height: 100%; border-radius: 6px; background: linear-gradient(90deg, var(--accent2), var(--accent)); transition: width 0.6s cubic-bezier(0.22,1,0.36,1); }
    .sb-marker{ position: absolute; top: -3px; width: 2px; height: 18px; background: var(--gold); border-radius: 1px; }
    .sb-legends { display: flex; gap: 14px; margin-top: 8px; flex-wrap: wrap; }
    .sbl-item { display: flex; align-items: center; gap: 5px; font-size: 0.68rem; color: var(--muted); }
    .sbl-dot  { width: 7px; height: 7px; border-radius: 50%; }
    .donut-row    { display: flex; align-items: center; gap: 24px; }
    .donut-svg    { width: 100px; height: 100px; flex-shrink: 0; }
    .donut-legend { display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .dl-item  { display: flex; align-items: center; justify-content: space-between; }
    .dl-label { display: flex; align-items: center; gap: 7px; font-size: 0.78rem; color: var(--muted); }
    .dl-dot   { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .dl-val   { font-size: 0.8rem; font-weight: 600; }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); z-index: 300; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.25s; }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 28px; width: 420px; max-width: 90vw; transform: translateY(16px) scale(0.97); transition: transform 0.28s cubic-bezier(0.22,1,0.36,1); }
    .modal-overlay.open .modal { transform: translateY(0) scale(1); }
    .modal-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.05rem; margin-bottom: 6px; }
    .modal-sub   { font-size: 0.76rem; color: var(--muted); margin-bottom: 20px; }
    .modal-field { margin-bottom: 14px; }
    .modal-label { font-size: 0.72rem; color: var(--muted); margin-bottom: 6px; display: block; }
    .modal-input { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 0.85rem; outline: none; transition: border-color 0.18s; }
    .modal-input:focus { border-color: var(--accent); }
    .modal-input.error { border-color: var(--danger); }
    .field-hint  { font-size: 0.68rem; color: var(--muted); margin-top: 4px; }
    .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
    .modal-btn   { flex: 1; height: 38px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface2); color: var(--muted); font-size: 0.82rem; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.18s; }
    .modal-btn.confirm { background: var(--accent); border-color: var(--accent); color: #0a0d0f; font-weight: 700; }
    .modal-btn.confirm:hover { opacity: 0.88; }
    .modal-btn.confirm:disabled { opacity: 0.5; cursor: not-allowed; }
    .modal-btn:hover:not(.confirm) { color: var(--text); }
    .recalc-preview { margin-top: 14px; padding: 12px; background: rgba(0,184,255,0.05); border: 1px solid rgba(0,184,255,0.15); border-radius: 10px; font-size: 0.76rem; }
    .recalc-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .recalc-row:last-child { margin-bottom: 0; }
    .empty-state { text-align: center; padding: 40px 20px; color: var(--muted); font-size: 0.85rem; }
    .empty-state .empty-icon { font-size: 2rem; margin-bottom: 8px; }
    .banner { padding: 10px 14px; border-radius: 10px; font-size: 0.76rem; margin-bottom: 16px; display: none; }
    .banner.warn { background: rgba(244,197,66,0.08); border: 1px solid rgba(244,197,66,0.25); color: var(--gold); display: flex; align-items: center; gap: 8px; }
    @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo"><a href="/admin/dashboard" class="logo-text">Mess<span>Mate</span></a><div class="logo-sub">Admin Portal</div></div>
  <div class="sidebar-campus">
    <div class="campus-icon" id="sidebarAvatar">?</div>
    <div><div class="campus-name" id="sidebarName">Loading…</div><div class="campus-role" id="sidebarEmail">admin</div></div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-label">Overview</div>
    <a class="nav-item" href="/admin/dashboard"><span class="nav-icon">📊</span> Dashboard</a>
    <a class="nav-item" href="/admin/menu"><span class="nav-icon">📋</span> Menu Manager</a>
    <a class="nav-item" href="#"><span class="nav-icon">✅</span> Intentions</a>
    <a class="nav-item" href="#"><span class="nav-icon">👥</span> Students <span class="nav-badge blue">342</span></a>
    <div class="nav-label">Finance</div>
    <a class="nav-item active" href="/admin/budget"><span class="nav-icon">💰</span> Budget</a>
    <a class="nav-item" href="/admin/waste"><span class="nav-icon">♻️</span> Waste</a>
    <a class="nav-item" href="/admin/canteen"><span class="nav-icon">🏪</span> Canteen</a>
    <div class="nav-label">Reports</div>
    <a class="nav-item" href="#"><span class="nav-icon">📤</span> Reports <span class="nav-badge">2</span></a>
    <a class="nav-item" href="#"><span class="nav-icon">🔔</span> Alerts <span class="nav-badge">5</span></a>
    <a class="nav-item" href="#"><span class="nav-icon">⚙️</span> Settings</a>
  </nav>
  <div class="sidebar-bottom">
    <a class="logout-btn" href="/login" onclick="sessionStorage.removeItem('mm_session')">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg> Sign Out
    </a>
  </div>
</aside>

<div class="main">
  <div class="topbar">
    <div><h1>Budget Management</h1><p>Semester fee collection, per-meal costs, and spend analysis</p></div>
    <div class="topbar-right">
      <div class="tb-btn" onclick="exportBudget()">⬇ Export</div>
      <div class="tb-btn primary" onclick="openBudgetModal()">⚙ Set Budget</div>
      <div class="mobile-menu-btn" onclick="toggleSidebar()">☰</div>
    </div>
  </div>

  <div class="content">

    <!-- Offline warning banner — shown only when API is unreachable -->
    <div class="banner warn" id="offlineBanner">
      ⚠ Backend is unreachable. Displaying last known data. Changes will not be saved until the server is back online.
    </div>

    <div class="stats-row">
      <div class="stat-card loading" id="card-fee">
        <div class="sc-label">Total Fee Collected</div>
        <div class="sc-val" id="totalFee" style="color:var(--accent2)">—</div>
        <div class="sc-sub" id="feeBreakdown">— students · ₹—/head</div>
      </div>
      <div class="stat-card loading" id="card-exp">
        <div class="sc-label">Expenditure (<span id="expMonthLabel">Current Month</span>)</div>
        <div class="sc-val" id="expenses" style="color:var(--accent)">—</div>
        <div class="sc-sub"><span class="badge bgo" id="expPct">—% of fee</span></div>
      </div>
      <div class="stat-card loading" id="card-meal">
        <div class="sc-label">Per-Meal Cost (Avg)</div>
        <div class="sc-val" id="perMealCost" style="color:var(--gold)">—</div>
        <div class="sc-sub">Target: <span id="mealTarget">₹—</span> · <span class="badge" id="mealDiff">—</span></div>
      </div>
      <div class="stat-card loading" id="card-surplus">
        <div class="sc-label">Surplus This Month</div>
        <div class="sc-val" id="surplus" style="color:var(--accent2)">—</div>
        <div class="sc-sub" id="surplusNote">—</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3>Semester Budget Progress</h3>
        <span style="font-size:0.72rem;color:var(--muted)" id="semesterLabel">—</span>
      </div>
      <div class="panel-body">
        <div class="semester-bar">
          <div class="sb-row">
            <span class="sc-label">Total Budget</span>
            <span id="totalBudgetLabel">—</span>
          </div>
          <div class="sb-track" style="margin-bottom:12px">
            <div class="sb-fill" id="progressBar" style="width:0%"></div>
            <div class="sb-marker" id="projectedMarker" style="left:0%"></div>
          </div>
          <div class="sb-legends">
            <div class="sbl-item"><div class="sbl-dot" style="background:var(--accent2)"></div><span id="leg-spent">Spent: —</span></div>
            <div class="sbl-item"><div class="sbl-dot" style="background:var(--gold)"></div><span id="leg-proj">Projected total: —</span></div>
            <div class="sbl-item"><div class="sbl-dot" style="background:var(--surface3)"></div><span id="leg-remain">Remaining: —</span></div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:6px;" id="monthGrid"></div>
      </div>
    </div>

    <div class="two-col">
      <div class="panel">
        <div class="panel-head"><h3 id="breakdownTitle">Expenditure Breakdown</h3></div>
        <div class="panel-body">
          <div class="donut-row">
            <svg class="donut-svg" id="donutSvg" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="14" fill="none" stroke="#1e2428" stroke-width="3.5"/>
              <!-- segments injected dynamically -->
            </svg>
            <div class="donut-legend" id="breakdownLegend">
              <div class="empty-state"><div class="empty-icon">📊</div>Loading…</div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><h3>Cost Per Meal Type</h3></div>
        <div class="panel-body">
          <div id="mealBars"></div>
          <div style="margin-top:16px;padding:12px;background:rgba(0,184,255,0.05);border:1px solid rgba(0,184,255,0.2);border-radius:10px;font-size:0.78rem;">
            <div style="display:flex;justify-content:space-between;margin-bottom:4px">
              <span style="color:var(--muted)">Daily avg per student</span>
              <span id="dailyAvg" style="font-family:'Syne',sans-serif;font-weight:800;color:var(--accent)">—</span>
            </div>
            <div style="display:flex;justify-content:space-between">
              <span style="color:var(--muted)">Budget per student per day</span>
              <span id="dailyBudget" style="color:var(--accent2);font-weight:600">—</span>
            </div>
          </div>
          <div id="mealStatusNote" style="margin-top:10px;padding:10px;border-radius:10px;font-size:0.75rem;"></div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3 id="spendLogTitle">Daily Spend Log</h3>
        <span class="panel-action" onclick="exportBudget()">Export CSV →</span>
      </div>
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Date</th><th>Students Served</th>
              <th>Breakfast</th><th>Lunch</th><th>Dinner</th><th>Snacks</th>
              <th>Total Spend</th><th>Per Head</th><th>vs Budget</th>
            </tr>
          </thead>
          <tbody id="spendTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- SET BUDGET MODAL -->
<div class="modal-overlay" id="budgetModal" onclick="handleOverlayClick(event)">
  <div class="modal">
    <div class="modal-title">⚙ Set Budget Parameters</div>
    <div class="modal-sub">Changes recalculate all totals and surplus figures instantly.</div>
    <div class="modal-field">
      <label class="modal-label">Semester Fee Per Student (₹)</label>
      <input class="modal-input" type="number" id="feeInput" placeholder="e.g. 78000" min="1000" max="500000">
      <div class="field-hint">Total budget = fee × enrolled students</div>
    </div>
    <div class="modal-field">
      <label class="modal-label">Total Students Enrolled</label>
      <input class="modal-input" type="number" id="studentsInput" placeholder="e.g. 678" min="1" max="10000">
    </div>
    <div class="modal-field">
      <label class="modal-label">Per-Meal Cost Target (₹)</label>
      <input class="modal-input" type="number" id="targetInput" placeholder="e.g. 89" min="10" max="1000">
      <div class="field-hint">Used to flag when actual cost drifts above target</div>
    </div>
    <div class="modal-field">
      <label class="modal-label">Semester Duration (days)</label>
      <input class="modal-input" type="number" id="semesterDaysInput" placeholder="e.g. 120" min="30" max="365">
      <div class="field-hint">Used to compute daily per-student budget (fee ÷ days)</div>
    </div>
    <div class="recalc-preview" id="recalcPreview" style="display:none">
      <div style="font-size:0.7rem;color:var(--muted);font-weight:600;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:8px;">Live Preview</div>
      <div class="recalc-row"><span style="color:var(--muted)">Total fee collected</span><span id="prev-total" style="font-weight:700;color:var(--accent2)">—</span></div>
      <div class="recalc-row"><span style="color:var(--muted)">Daily budget / student</span><span id="prev-daily" style="font-weight:700;color:var(--accent)">—</span></div>
      <div class="recalc-row"><span style="color:var(--muted)">Surplus vs current spend</span><span id="prev-surplus" style="font-weight:700">—</span></div>
    </div>
    <div class="modal-actions">
      <button class="modal-btn" onclick="closeBudgetModal()">Cancel</button>
      <button class="modal-btn confirm" id="confirmBtn" onclick="updateBudget()">Apply Changes</button>
    </div>
  </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>
<div id="overlay" onclick="toggleSidebar()"></div>

<script src="/js/main.js"></script>
<script>
requireAdminSession();

// ─── Sidebar identity ─────────────────────────────────────────────────────────
const _s  = JSON.parse(sessionStorage.getItem('mm_session') || '{}');
const _av = document.getElementById('sidebarAvatar');
if (_s.profilePic) {
  _av.innerHTML = `<img src="${_s.profilePic}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
} else {
  _av.textContent = (_s.name || 'Admin').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
}
document.getElementById('sidebarName').textContent  = _s.name  || 'Admin';
document.getElementById('sidebarEmail').textContent = _s.email || 'admin';

// ─── State ────────────────────────────────────────────────────────────────────
// Holds the last successfully loaded budget from the API.
// Nothing is hardcoded — populated entirely from server response.
let _budgetState = null;

// Donut chart colour palette (index-matched to categoryBreakdown array)
const DONUT_COLORS = [
  'var(--accent2)',  // teal/green
  'var(--accent)',   // blue
  'var(--gold)',     // yellow
  'var(--orange)',   // orange
  'var(--purple)',   // purple
  '#e879a0',         // pink (6th category if present)
];

// ─── Helpers ──────────────────────────────────────────────────────────────────
/**
 * Compute daily per-student budget.
 * semesterDays comes from the API — no magic number baked in.
 */
function dailyBudgetPerStudent(semesterFeePerStudent, semesterDays) {
  if (!semesterDays || semesterDays <= 0) return 0;
  return Math.round(semesterFeePerStudent / semesterDays);
}

/**
 * Build a human-readable semester label from the monthlyBreakdown keys.
 * e.g. { jan:…, feb:…, marProj:…, aprProj:… } → "Jan – Apr 2025"
 */
function buildSemesterLabel(monthlyBreakdown, semesterYear) {
  const monthNames = { jan:'Jan', feb:'Feb', mar:'Mar', apr:'Apr', may:'May',
                       jun:'Jun', jul:'Jul', aug:'Aug', sep:'Sep', oct:'Oct',
                       nov:'Nov', dec:'Dec' };
  // Strip "Proj" suffix to normalise projected months
  const keys = Object.keys(monthlyBreakdown).map(k => k.replace('Proj','').toLowerCase());
  const unique = [...new Set(keys)];
  const first  = monthNames[unique[0]] || unique[0];
  const last   = monthNames[unique[unique.length - 1]] || unique[unique.length - 1];
  const year   = semesterYear || new Date().getFullYear();
  return `${first} – ${last} ${year}`;
}

/**
 * Build SVG donut segments dynamically from categoryBreakdown data.
 * Circumference of r=14 circle ≈ 87.96
 */
function buildDonut(categoryBreakdown) {
  const CIRC = 87.96;
  const total = categoryBreakdown.reduce((s, c) => s + c.amount, 0);
  if (!total) return;

  const svg = document.getElementById('donutSvg');
  // Remove old dynamic segments (keep the background circle)
  svg.querySelectorAll('.donut-seg').forEach(el => el.remove());

  let offset = 25; // start at top
  categoryBreakdown.forEach((cat, i) => {
    const pct   = cat.amount / total;
    const dash  = +(pct * CIRC).toFixed(2);
    const gap   = +(CIRC - dash).toFixed(2);
    const color = cat.color || DONUT_COLORS[i] || '#888';
    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    circle.setAttribute('class', 'donut-seg');
    circle.setAttribute('cx', '18');
    circle.setAttribute('cy', '18');
    circle.setAttribute('r', '14');
    circle.setAttribute('fill', 'none');
    circle.setAttribute('stroke', color);
    circle.setAttribute('stroke-width', '3.5');
    circle.setAttribute('stroke-dasharray', `${dash} ${gap}`);
    circle.setAttribute('stroke-dashoffset', String(-offset + 25));
    circle.setAttribute('stroke-linecap', 'round');
    svg.appendChild(circle);
    offset += dash;
  });
}

// ─── Render ───────────────────────────────────────────────────────────────────
function renderBudget(data) {
  const {
    semesterFeePerStudent,
    totalStudents,
    expensesTotal,          // current month's total expenditure
    currentMonth,           // e.g. "Feb" — label for the expenditure card
    perMealCostAvg,
    perMealCostTarget,
    semesterYear,           // e.g. 2025
    semesterDays,           // actual semester length in days (no magic number)
    monthlyBreakdown,       // { jan, feb, marProj, aprProj, … }
    categoryBreakdown,      // [{ label, color, amount }, …]
    mealCosts,              // [{ label, cost, color }, …]
    dailyLog,               // [[date, students, breakfast, lunch, dinner, snacks, total, perHead], …]
  } = data;

  // ── Derived values ──────────────────────────────────────────────────────────
  const totalFeeCollected = semesterFeePerStudent * totalStudents;
  const surplus           = totalFeeCollected - expensesTotal;
  const expPct            = totalFeeCollected > 0
                              ? ((expensesTotal / totalFeeCollected) * 100).toFixed(1)
                              : 0;
  const mealDiff          = perMealCostAvg - perMealCostTarget;

  // Sum actual (non-projected) months
  const spent = Object.entries(monthlyBreakdown)
    .filter(([k]) => !k.toLowerCase().includes('proj'))
    .reduce((s, [, v]) => s + (v || 0), 0);

  // Sum all months (actual + projected) for full-semester projection
  const projTotal = Object.values(monthlyBreakdown).reduce((s, v) => s + (v || 0), 0);

  const spentPct = totalFeeCollected > 0 ? ((spent / totalFeeCollected) * 100).toFixed(0) : 0;
  const projPct  = totalFeeCollected > 0 ? ((projTotal / totalFeeCollected) * 100).toFixed(0) : 0;

  const mealAvgTotal     = mealCosts.reduce((a, m) => a + m.cost, 0);
  const dailyBudget      = dailyBudgetPerStudent(semesterFeePerStudent, semesterDays);

  // ── Stat cards ──────────────────────────────────────────────────────────────
  document.getElementById('totalFee').textContent     = fmtL(totalFeeCollected);
  document.getElementById('feeBreakdown').textContent = `${totalStudents} students · ${fmt(semesterFeePerStudent)} each`;

  document.getElementById('expMonthLabel').textContent = currentMonth || 'Current Month';
  document.getElementById('expenses').textContent      = fmtL(expensesTotal);
  document.getElementById('expPct').textContent        = `${expPct}% of fee`;

  document.getElementById('perMealCost').textContent = fmt(perMealCostAvg);
  document.getElementById('mealTarget').textContent  = fmt(perMealCostTarget);

  const mealDiffEl = document.getElementById('mealDiff');
  if (mealDiff > 0) {
    mealDiffEl.textContent = `+₹${mealDiff} over`;
    mealDiffEl.className = 'badge br';
  } else if (mealDiff < 0) {
    mealDiffEl.textContent = `₹${Math.abs(mealDiff)} under`;
    mealDiffEl.className = 'badge bg';
  } else {
    mealDiffEl.textContent = 'On target';
    mealDiffEl.className = 'badge bg';
  }

  document.getElementById('surplus').textContent    = fmtL(Math.abs(surplus));
  document.getElementById('surplusNote').textContent = surplus >= 0
    ? 'Rolled to maintenance fund'
    : 'Deficit — review spending';
  document.getElementById('surplus').style.color = surplus >= 0
    ? 'var(--accent2)' : 'var(--danger)';

  ['card-fee', 'card-exp', 'card-meal', 'card-surplus']
    .forEach(id => document.getElementById(id).classList.remove('loading'));

  // ── Semester progress bar ───────────────────────────────────────────────────
  document.getElementById('semesterLabel').textContent    = buildSemesterLabel(monthlyBreakdown, semesterYear);
  document.getElementById('totalBudgetLabel').textContent = fmt(totalFeeCollected);
  document.getElementById('progressBar').style.width      = `${Math.min(spentPct, 100)}%`;
  document.getElementById('projectedMarker').style.left   = `${Math.min(projPct, 100)}%`;
  document.getElementById('leg-spent').textContent  = `Spent: ${fmtL(spent)} (${spentPct}%)`;
  document.getElementById('leg-proj').textContent   = `Projected total: ${fmtL(projTotal)} (${projPct}%)`;
  document.getElementById('leg-remain').textContent = `Remaining: ${fmtL(totalFeeCollected - spent)}`;

  // ── Month grid — built from API data, not hard-coded labels ────────────────
  const monthNameMap = {
    jan:'Jan', feb:'Feb', mar:'Mar', apr:'Apr', may:'May', jun:'Jun',
    jul:'Jul', aug:'Aug', sep:'Sep', oct:'Oct', nov:'Nov', dec:'Dec',
  };
  document.getElementById('monthGrid').innerHTML = Object.entries(monthlyBreakdown)
    .map(([key, val]) => {
      const isProj  = key.toLowerCase().includes('proj');
      const baseKey = key.toLowerCase().replace('proj', '');
      const label   = (monthNameMap[baseKey] || key) + (isProj ? ' (projected)' : ' spent');
      const style   = isProj
        ? 'background:var(--surface2);border:1px solid var(--border);'
        : 'background:rgba(0,184,255,0.05);border:1px solid rgba(0,184,255,0.2);';
      const color   = isProj ? 'var(--muted)' : 'var(--accent)';
      const prefix  = isProj ? '~' : '';
      return `<div style="padding:12px;border-radius:10px;${style}text-align:center">
        <div style="font-family:'Syne',sans-serif;font-weight:800;color:${color};font-size:1.1rem">${prefix}${fmtL(val)}</div>
        <div style="font-size:0.65rem;color:var(--muted);margin-top:3px">${label}</div>
      </div>`;
    }).join('');

  // ── Expenditure breakdown donut ─────────────────────────────────────────────
  const breakdownMonth = currentMonth || 'Current Month';
  document.getElementById('breakdownTitle').textContent = `Expenditure Breakdown — ${breakdownMonth}`;

  if (categoryBreakdown && categoryBreakdown.length) {
    buildDonut(categoryBreakdown);
    const catTotal = categoryBreakdown.reduce((s, c) => s + c.amount, 0);
    document.getElementById('breakdownLegend').innerHTML = categoryBreakdown.map((c, i) => {
      const color = c.color || DONUT_COLORS[i] || '#888';
      const pct   = catTotal > 0 ? ((c.amount / catTotal) * 100).toFixed(0) : 0;
      return `<div class="dl-item">
        <span class="dl-label"><div class="dl-dot" style="background:${color}"></div>${c.label}</span>
        <span class="dl-val">${fmtL(c.amount)} <span style="color:var(--muted);font-weight:400;font-size:0.7rem">(${pct}%)</span></span>
      </div>`;
    }).join('');
  } else {
    document.getElementById('breakdownLegend').innerHTML =
      '<div class="empty-state"><div class="empty-icon">📊</div>No breakdown data available</div>';
  }

  // ── Meal cost bars ──────────────────────────────────────────────────────────
  if (mealCosts && mealCosts.length) {
    const maxCost = Math.max(...mealCosts.map(m => m.cost));
    document.getElementById('mealBars').innerHTML = mealCosts.map((m, i) => {
      const color = m.color || DONUT_COLORS[i] || 'var(--accent)';
      const pct   = maxCost > 0 ? (m.cost / maxCost * 100).toFixed(0) : 0;
      return `<div class="prog-row">
        <span class="prog-label">${m.label}</span>
        <div class="prog-track"><div class="prog-fill" style="width:${pct}%;background:${color}"></div></div>
        <span class="prog-val" style="color:${color}">${fmt(m.cost)}</span>
      </div>`;
    }).join('');
  } else {
    document.getElementById('mealBars').innerHTML =
      '<div class="empty-state"><div class="empty-icon">🍽️</div>No meal cost data</div>';
  }

  document.getElementById('dailyAvg').textContent    = fmt(mealAvgTotal);
  document.getElementById('dailyBudget').textContent = dailyBudget > 0 ? fmt(dailyBudget) : '—';

  const underBy = dailyBudget - mealAvgTotal;
  const noteEl  = document.getElementById('mealStatusNote');
  if (dailyBudget > 0) {
    if (underBy >= 0) {
      noteEl.style.cssText = 'background:rgba(0,229,160,0.05);border:1px solid rgba(0,229,160,0.2);color:var(--accent2);';
      noteEl.textContent   = `✓ ₹${underBy}/day under budget — good headroom for ingredient price fluctuations`;
    } else {
      noteEl.style.cssText = 'background:rgba(255,71,87,0.05);border:1px solid rgba(255,71,87,0.2);color:var(--danger);';
      noteEl.textContent   = `⚠ ₹${Math.abs(underBy)}/day over daily budget — review meal costs`;
    }
  } else {
    noteEl.textContent   = 'Set semester days in Budget Settings to see daily budget comparison.';
    noteEl.style.cssText = 'color:var(--muted);';
  }

  // ── Daily spend log ─────────────────────────────────────────────────────────
  if (currentMonth) {
    document.getElementById('spendLogTitle').textContent = `Daily Spend Log — ${currentMonth}`;
  }

  const tbody = document.getElementById('spendTable');
  if (!dailyLog || dailyLog.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--muted);padding:24px;">No daily log entries available</td></tr>`;
  } else {
    tbody.innerHTML = dailyLog.map(r => {
      const perHead = r[7];
      const diff    = typeof perHead === 'number' ? perHead - mealAvgTotal : null;
      const diffStr = diff !== null
        ? (diff >= 0
            ? `<span style="color:var(--danger)">+₹${diff}</span>`
            : `<span style="color:var(--accent2)">−₹${Math.abs(diff)}</span>`)
        : '—';
      const fmtCell = v => typeof v === 'number' ? `₹${v.toLocaleString('en-IN')}` : v;
      return `<tr>
        <td style="font-weight:500">${r[0]}</td>
        <td>${r[1]}</td>
        <td style="color:var(--muted)">${fmtCell(r[2])}</td>
        <td style="color:var(--muted)">${fmtCell(r[3])}</td>
        <td style="color:var(--muted)">${fmtCell(r[4])}</td>
        <td style="color:var(--muted)">${fmtCell(r[5])}</td>
        <td style="font-family:'Syne',sans-serif;font-weight:700;color:var(--accent)">${fmtCell(r[6])}</td>
        <td>${fmtCell(r[7])}</td>
        <td>${diffStr}</td>
      </tr>`;
    }).join('');
  }

  // Persist state for modal pre-fill
  _budgetState = {
    semesterFeePerStudent,
    totalStudents,
    perMealCostTarget,
    semesterDays,
    expensesTotal,
  };
}

// ─── Load from API ────────────────────────────────────────────────────────────
async function loadBudget() {
  try {
    const res = await fetch('/api/budget', { signal: AbortSignal.timeout(6000) });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    document.getElementById('offlineBanner').style.display = 'none';
    renderBudget(data);
  } catch (e) {
    // Show offline banner — do NOT silently fall back to fake data
    document.getElementById('offlineBanner').style.display = 'flex';
    showToast('Could not reach backend — displaying cached data', 'var(--gold)');

    // Only render cached state if we already had a successful load this session
    if (_budgetState) {
      // Re-render with last known good data — real values, not mock
      renderBudget({ ..._budgetState });
    } else {
      // No cached data at all — show empty state, prompt admin to check server
      ['card-fee', 'card-exp', 'card-meal', 'card-surplus']
        .forEach(id => document.getElementById(id).classList.remove('loading'));
      document.getElementById('spendTable').innerHTML =
        `<tr><td colspan="9" style="text-align:center;color:var(--muted);padding:32px;">
          ⚠ Could not load budget data. Please ensure the server is running and try again.
        </td></tr>`;
    }
  }
}

// ─── Update budget via API ────────────────────────────────────────────────────
async function updateBudget() {
  const fee          = parseInt(document.getElementById('feeInput').value);
  const students     = parseInt(document.getElementById('studentsInput').value);
  const target       = parseInt(document.getElementById('targetInput').value);
  const semesterDays = parseInt(document.getElementById('semesterDaysInput').value);

  const inputs = ['feeInput', 'studentsInput', 'targetInput', 'semesterDaysInput'];
  let valid = true;
  inputs.forEach(id => {
    const el = document.getElementById(id);
    if (!el.value || isNaN(parseInt(el.value))) {
      el.classList.add('error');
      valid = false;
    }
  });
  if (!valid) { showToast('Please fill in all fields', 'var(--danger)'); return; }

  const btn = document.getElementById('confirmBtn');
  btn.disabled = true; btn.textContent = 'Saving…';

  try {
    const res = await fetch('/api/budget', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ semesterFeePerStudent: fee, totalStudents: students, perMealCostTarget: target, semesterDays }),
      signal: AbortSignal.timeout(8000),
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const updated = await res.json();
    renderBudget(updated);
    showToast('Budget updated successfully', 'var(--accent2)');
    document.getElementById('offlineBanner').style.display = 'none';
  } catch (e) {
    if (e.name === 'TimeoutError' || e.name === 'AbortError') {
      showToast('Request timed out — server may still have saved. Refresh to confirm.', 'var(--gold)');
    } else {
      showToast(`Failed to save: ${e.message}`, 'var(--danger)');
    }
  } finally {
    btn.disabled = false;
    btn.textContent = 'Apply Changes';
    closeBudgetModal();
  }
}

// ─── Modal ────────────────────────────────────────────────────────────────────
function openBudgetModal() {
  if (_budgetState) {
    if (_budgetState.semesterFeePerStudent) document.getElementById('feeInput').value          = _budgetState.semesterFeePerStudent;
    if (_budgetState.totalStudents)         document.getElementById('studentsInput').value      = _budgetState.totalStudents;
    if (_budgetState.perMealCostTarget)     document.getElementById('targetInput').value        = _budgetState.perMealCostTarget;
    if (_budgetState.semesterDays)          document.getElementById('semesterDaysInput').value  = _budgetState.semesterDays;
  }
  updatePreview();
  document.getElementById('budgetModal').classList.add('open');
}

function closeBudgetModal() { document.getElementById('budgetModal').classList.remove('open'); }
function handleOverlayClick(e) { if (e.target === e.currentTarget) closeBudgetModal(); }

function updatePreview() {
  const fee          = parseInt(document.getElementById('feeInput').value) || 0;
  const stu          = parseInt(document.getElementById('studentsInput').value) || 0;
  const days         = parseInt(document.getElementById('semesterDaysInput').value) || 0;
  const prev         = document.getElementById('recalcPreview');
  if (!fee || !stu) { prev.style.display = 'none'; return; }

  prev.style.display = 'block';
  const total   = fee * stu;
  const daily   = days > 0 ? Math.round(fee / days) : 0;
  const exp     = (_budgetState || {}).expensesTotal || 0;
  const sur     = total - exp;

  document.getElementById('prev-total').textContent = fmtL(total);
  document.getElementById('prev-daily').textContent = daily > 0 ? `${fmt(daily)}/day` : '— (set semester days)';

  const surEl = document.getElementById('prev-surplus');
  surEl.textContent  = fmtL(Math.abs(sur)) + (sur >= 0 ? ' surplus' : ' deficit');
  surEl.style.color  = sur >= 0 ? 'var(--accent2)' : 'var(--danger)';
}

// ─── Export ───────────────────────────────────────────────────────────────────
function exportBudget() {
  showToast('Generating CSV…', 'var(--accent2)');
  const rows = [['Date', 'Students Served', 'Breakfast', 'Lunch', 'Dinner', 'Snacks', 'Total Spend', 'Per Head', 'vs Budget']];
  document.querySelectorAll('#spendTable tr').forEach(tr => {
    rows.push([...tr.querySelectorAll('td')].map(td => td.textContent.trim()));
  });
  downloadCSV(rows, 'budget_spend_log.csv');
}

// ─── Init ─────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  loadBudget();
  ['feeInput', 'studentsInput', 'targetInput', 'semesterDaysInput'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', () => { el.classList.remove('error'); updatePreview(); });
  });
});
document.addEventListener('DOMContentLoaded', initThemeToggles);
</script>
</body>
</html>
